import Mathlib

/-!
# P033 — General finite-palette residue obstruction

For a finite collection S of edge-sum colors in ZMod m, suppose every
color equals p modulo m. A path through edges whose endpoints sum to
one of the colors can only visit its initial residue and p minus that
residue.

This generalizes the previously verified two-color structural lemma
to any finite palette, without assuming primality or graph connectivity.
The theorem is independent of the analytic number theory used in P033.

The separate assertion that gcd of the half-differences is 1 for a
connected three-prime palette requires additional arithmetic and
connectedness formalization; it is NOT claimed here.
-/

namespace P033

variable {m : ℕ}

/-- An edge in a graph whose allowed sums form the finite palette S. -/
def PaletteStep (S : Finset (ZMod m)) (x y : ZMod m) : Prop :=
  x + y ∈ S

/-- The path relation generated by the palette edges. -/
inductive PaletteReach (S : Finset (ZMod m)) :
    ZMod m → ZMod m → Prop
  | refl (x) : PaletteReach S x x
  | step {x y z} (hxy : PaletteStep S x y)
      (hyz : PaletteReach S y z) : PaletteReach S x z

/-- If all the colors coincide modulo m, a path visits at most two
    residue classes: x and its reflection p-x. -/
theorem finite_palette_orbit
    (S : Finset (ZMod m)) (p : ZMod m)
    (hS : ∀ s ∈ S, s = p)
    {x z : ZMod m}
    (h : PaletteReach S x z) :
    z = x ∨ x + z = p := by
  induction h with
  | refl x =>
      exact Or.inl rfl
  | @step x y z hedge htail ih =>
      have hxy : x + y = p := hS (x + y) hedge
      rcases ih with hz | hreflect
      · exact Or.inr (by simpa only [hz] using hxy)
      · left
        symm
        calc
          x = x + y - y := by abel
          _ = p - y := by rw [hxy]
          _ = (y + z) - y := by rw [hreflect]
          _ = z := by abel

/-- Two noninitial residues in the same component of a single
    reflection-modulus palette must coincide. -/
theorem finite_palette_at_most_two
    (S : Finset (ZMod m)) (p : ZMod m)
    (hS : ∀ s ∈ S, s = p)
    {x y z : ZMod m}
    (hxy : PaletteReach S x y) (hxz : PaletteReach S x z)
    (hy : y ≠ x) (hz : z ≠ x) : y = z := by
  rcases finite_palette_orbit S p hS hxy with h | h
  · exact (hy h).elim
  · rcases finite_palette_orbit S p hS hxz with k | k
    · exact (hz k).elim
    · exact add_left_cancel (h.trans k.symm)

/-- In particular, any triple of colors congruent modulo m
    constrains every path to at most two residue classes. -/
theorem three_palette_orbit
    (p q r : ZMod m)
    (hpq : p = q) (hpr : p = r)
    {x z : ZMod m}
    (h : PaletteReach ({p, q, r} : Finset (ZMod m)) x z) :
    z = x ∨ x + z = p := by
  apply finite_palette_orbit ({p, q, r} : Finset (ZMod m)) p ?_ h
  intro s hs
  simp only [Finset.mem_insert, Finset.mem_singleton] at hs
  rcases hs with heq | heq | heq
  · exact heq
  · exact heq.trans hpq.symm
  · exact heq.trans hpr.symm

/-- No three distinct residues can all lie in one path component
    of such a three-color graph. -/
theorem three_palette_no_three
    (p q r : ZMod m)
    (hpq : p = q) (hpr : p = r)
    {x y z : ZMod m}
    (hxy : PaletteReach ({p, q, r} : Finset (ZMod m)) x y)
    (hxz : PaletteReach ({p, q, r} : Finset (ZMod m)) x z)
    (hy : y ≠ x) (hz : z ≠ x) : y = z := by
  rcases three_palette_orbit p q r hpq hpr hxy with h | h
  · exact (hy h).elim
  · rcases three_palette_orbit p q r hpq hpr hxz with k | k
    · exact (hz k).elim
    · exact add_left_cancel (h.trans k.symm)

#print axioms finite_palette_orbit
#print axioms finite_palette_at_most_two
#print axioms three_palette_orbit
#print axioms three_palette_no_three

end P033
