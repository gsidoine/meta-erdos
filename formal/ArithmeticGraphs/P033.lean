import Mathlib

/-!
A generic additive-group obstruction behind prime-sum palette connectivity.
Two edge sums that are congruent modulo m constrain an entire connected
component to at most two residue classes. The formal theorem is over ZMod m.

This is a local structural certificate, not a Lean proof of P033's full
two-prime or three-prime connectivity assertions.
-/

namespace P033

variable {m : ℕ}

/-- One unoriented edge with one of two prescribed sum colors. -/
def Step (p q : ZMod m) (x y : ZMod m) : Prop :=
  x + y = p ∨ x + y = q

/-- Finite paths generated by the two sum-color relations. -/
inductive Reach (p q : ZMod m) : ZMod m → ZMod m → Prop
  | refl (x) : Reach p q x x
  | step {x y z} (hxy : Step p q x y) (hyz : Reach p q y z) :
      Reach p q x z

/-- If two colors coincide modulo m, each reachable residue is either
    the starting residue or its reflection across the common sum. -/
theorem two_color_orbit {p q x z : ZMod m}
    (hpq : p = q) (h : Reach p q x z) :
    z = x ∨ x + z = p := by
  induction h with
  | refl x =>
      exact Or.inl rfl
  | @step x y z hedge htail ih =>
      have hxy : x + y = p := by
        rcases hedge with hxy | hxy
        · exact hxy
        · simpa only [hpq] using hxy
      rcases ih with hz | hreflect
      · exact Or.inr (by simpa only [hz] using hxy)
      · left
        symm
        calc
          x = x + y - y := by abel
          _ = p - y := by rw [hxy]
          _ = (y + z) - y := by rw [hreflect]
          _ = z := by abel

/-- Two distinct vertices reachable from the same starting residue
    cannot both differ from the start and from one another. -/
theorem two_color_at_most_two {p q x y z : ZMod m}
    (hpq : p = q) (hxy : Reach p q x y) (hxz : Reach p q x z)
    (hy : y ≠ x) (hz : z ≠ x) : y = z := by
  rcases two_color_orbit hpq hxy with h | h
  · exact (hy h).elim
  · rcases two_color_orbit hpq hxz with k | k
    · exact (hz k).elim
    · exact add_left_cancel (h.trans k.symm)

#print axioms two_color_orbit
#print axioms two_color_at_most_two

end P033
